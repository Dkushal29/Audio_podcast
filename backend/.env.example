# Server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://echospace:echospace@localhost:5432/echospace?schema=public"

# JWT
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# Storage (local prototype, S3/MinIO-compatible abstraction)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
PUBLIC_BASE_URL=http://localhost:8080
