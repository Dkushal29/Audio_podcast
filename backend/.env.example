# Server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ALLOW_EXTENSION_CORS=true

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://echospace:echospace@localhost:5432/echospace?schema=public"

# JWT
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# Storage (local for dev, or s3 for Tigris / S3-compatible object storage in production)
STORAGE_DRIVER=local
ALLOW_EPHEMERAL_STORAGE=false
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
PUBLIC_BASE_URL=http://localhost:8080

# Tigris / S3-Compatible Object Storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://t3.storage.dev
S3_REGION=auto
S3_BUCKET=echospace.media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_EXPIRES_IN=3600

# Deepgram Audio Intelligence (backend-only secret)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
