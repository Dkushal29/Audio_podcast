# Server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ALLOW_EXTENSION_CORS=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://echospace:echospace@localhost:5432/echospace?schema=public"

# JWT
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# Storage (local prototype, or s3 for production S3-compatible object storage)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
PUBLIC_BASE_URL=http://localhost:8080

# S3-Compatible Object Storage (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
